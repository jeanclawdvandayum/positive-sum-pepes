# .env.example for PSP Fork Tests
#
# Copy to .env and fill in:
#   cp .example.env .env

# Required: Mainnet RPC URL
# Options:
#   Alchemy:  https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
#   Infura:   https://mainnet.infura.io/v3/YOUR_KEY
#   Tenderly: https://rpc.tenderly.co/fork/YOUR_ID
#   QuickNode, etc.
MAINNET_RPC_URL=

# Optional: Pin block for reproducible tests
# Leave empty for latest block
FORK_BLOCK_NUMBER=
