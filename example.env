# ─────────────────────────────────────────────────────────────────────────────
# PSP — environment template
#
#   cp example.env .env     (root, for forge)
#   cp example.env frontend/.env.local   (fill the VITE_* half, for the dapp)
#
# .env is gitignored. NEVER commit real keys.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════
# 1) SEPOLIA TESTNET DEPLOYMENT  (forge script script/DeployPSP.s.sol)
# ═════════════════════════════════════════════════════════════════

# Deployer private key — a THROWAWAY test wallet with a little Sepolia ETH
# (faucet: https://sepoliafaucet.com / https://www.alchemy.com/faucets/ethereum-sepolia)
# Fund it with ≥ 0.5 ETH; the full deploy (factory + hook mining + UI html
# upload) runs comfortably under that.
PRIVATE_KEY=0xYOUR_TEST_WALLET_PRIVATE_KEY_HERE

# Sepolia RPC — any provider works:
#   Alchemy:  https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY   (free tier fine)
#   Infura:   https://sepolia.infura.io/v3/YOUR_KEY
#   Public:   https://ethereum-sepolia-rpc.publicnode.com     (no key, rate-limited)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE

# Etherscan API key — for `forge verify` / contract source verification
# Free: https://etherscan.io/myapikey  (1 key covers all EVM chains)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY_HERE

# ── deploy flags (see script/DeployPSP.s.sol header for the full list) ──
# Testnet mode: deploys SepoliaMixETH + MixETHFaucet (0.0001 ETH -> 100 mix)
# + the timing profile below (mainnet path ignores these and uses protocol
# defaults: 7d predeposit / 42d vest / 3d vote).
PSP_TESTNET=1

# ── playtest timing knobs (SECONDS, testnet only — tune per playtest) ──
# Predeposit window length. Default 86400 (1 day).
PSP_PREDEPOSIT_SEC=86400
# Unstake vest duration — boost decays linearly to zero over this span in
# 6 equal epochs. MUST be divisible by 6 (deploy reverts otherwise).
# Default 172800 (2 days -> 8h decay epochs).
PSP_VEST_SEC=172800
# Carpet-bomb voting period. Default 86400 (1 day).
PSP_VOTE_SEC=86400

# Canonical Uniswap v4 PoolManager on Sepolia (verified on-chain):
PSP_PM=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543

# Curve flavor: 1 = glide (default) · 2 = longswell · 3 = switchback · 0 = legacy ladder
PSP_CURVE=4
# 4  = 2-zone S-curve, the ONLY flavor that fits ETH Sepolia's 2^24 per-tx cap
# 0  = canonical 34-zone anchor-ladder STAIRCASE (27.5M gas) — needs a chain
#      without a per-tx cap: Base Sepolia (PM 0x05E73354cFDd6745C338b50BcFDfA3Aa6fA03408,
#      1.2B block limit, fork dry-run verified) or mainnet. NOT ETH Sepolia —
#      rebirth (spawnNextRound) is single-tx, so an over-cap curve can never
#      be reborn either.
# 5  = lean 10-zone ladder (17.5M floor) — mid-cap chains only, still over ETH Sepolia

# Fork dry-run BEFORE spending gas — full testnet path against forked Sepolia
# state, any throwaway key, zero cost:
#   PSP_FORK=1 PSP_TESTNET=1 PSP_PM=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543 \
#     forge script script/DeployPSP.s.sol --fork-url $SEPOLIA_RPC_URL \
#     --private-key 0xac0974bec39a17e36ba4a6b4d8d05b70d4c1c8e9b6d0d3d0d0d0d0d0d0d0d01
# NEVER set PSP_FORK=1 for a real deployment.
PSP_FORK=

# ── the actual deploy command ──
#   source .env
#   forge script script/DeployPSP.s.sol --rpc-url $SEPOLIA_RPC_URL \
#     --private-key $PRIVATE_KEY --broadcast
#
# Verify on Etherscan afterwards:
#   forge script script/DeployPSP.s.sol --rpc-url $SEPOLIA_RPC_URL \
#     --private-key $PRIVATE_KEY --verify --resume


# ═════════════════════════════════════════════════════════════════
# 2) FRONTEND  (frontend/.env.local — pick the VITE_* half only)
# ═════════════════════════════════════════════════════════════════

# 11155111 = Sepolia (31337 = local anvil)
VITE_CHAIN_ID=84532

# Base Sepolia (round 2+: full 34-zone staircase). Browser-reachable RPC:
VITE_RPC_URL=https://base-sepolia-rpc.publicnode.com
# (previous round 1 config, kept for reference:
#  VITE_CHAIN_ID=11155111 / https://ethereum-sepolia-rpc.publicnode.com)

# Filled from the deploy's console output (factory / zapIn / zapOut lines):
VITE_FACTORY=0x0000000000000000000000000000000000000000
VITE_ZAP_IN=0x0000000000000000000000000000000000000000
VITE_ZAP_OUT=0x0000000000000000000000000000000000000000


# ═════════════════════════════════════════════════════════════════
# 3) MAINNET-FORK TESTING  (existing test suites, profile "fork")
# ═════════════════════════════════════════════════════════════════

# Ethereum mainnet RPC for fork tests (test/audit/*, test/attack/*)
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE

# Pin a block for reproducible fork tests (empty = latest)
FORK_BLOCK_NUMBER=
