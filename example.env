# PSP fresh Base Sepolia release (chain 84532).
# Optional: copy to .env, edit, then export with: set -a; source .env; set +a
# Never copy this deployment file into frontend/.env.local.
# The runner generates a separate frontend.env from confirmed deployment state.

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# For live deployment use a named encrypted Foundry keystore and its address.
# Import interactively: cast wallet import psp-testnet --interactive
# The deployment runner never selects a plaintext PRIVATE_KEY environment value.
PSP_DEPLOY_ACCOUNT=psp-testnet
PSP_DEPLOYER=

# The runner pins these flags and the canonical Base Sepolia PoolManager.
# They also support direct use of the Solidity scripts.
PSP_TESTNET=true
PSP_ANVIL=false
PSP_FORK=false
PSP_PM=0x05E73354cFDd6745C338b50BcFDfA3Aa6fA03408
PSP_HTML=script/testnet-status.html

# Seconds. Vesting has six equal epochs.
PSP_PREDEPOSIT_SEC=259200
PSP_VEST_SEC=2419200
PSP_DET_SEC=248660
# Whole mixETH per wallet, 0 = uncapped. The pooled IBCO is uncapped.
PSP_WALLET_CAP_MIX=0

# Active gross buy minimum: 0.005 mixETH. Ticket price starts there and rises
# linearly by 0.42% of that base per post-genesis mixETH added to the pot.
# Each whole ticket adds up to 69 seconds, subject to the clock cap.
# Public predeposits accept any positive amount.

# Indefinite tilted sine, reference calibration at 450 mixETH net IBCO backing.
# The actual third-wave reserve target scales with the raise. Prices use wei/WAD.
PSP_SINE_P0=10000000000000
PSP_SINE_PREK=4477562267871699
PSP_SINE_PTARGET=60000000000000000
PSP_SINE_TARGET_RESERVE=10000000000000000000000
PSP_SINE_AMPBPS=10000

# Optional immutable recipient override. Defaults to the broadcaster.
# PSP_DEPLOYER_CUT_TO=0x...

# Default: isolated local Anvil fork, disposable unlocked account, no live writes.
# node scripts/deployment/base-sepolia.mjs --dry-run
# Explicit live release, after the reviewed source is committed:
# node scripts/deployment/base-sepolia.mjs --broadcast --verify
# Results: out/releases/<run>/manifest.json, frontend.env, receipts and build-info.
# Full instructions: docs/audit/BASE-SEPOLIA-DEPLOY.md

# Optional Etherscan V2 key for manual Basescan verification.
# The runner's --verify path uses public Sourcify verification without a key.
ETHERSCAN_API_KEY=

# Mainnet game/fork testing remains deferred and separate from this release.
# MAINNET_RPC_URL=
# FORK_BLOCK_NUMBER=

# WNS names need their separate Ethereum deployment and fresh-factory verifier
# configuration. The generated game frontend.env leaves registration disabled.
# WalletConnect configuration belongs only in the generated frontend env:
# VITE_WC_PROJECT_ID=
