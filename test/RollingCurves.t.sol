        assertEq(CurveMath.curveIntegral(0, 7441620828958361808535552, cc), 31999999999973380735598);
        assertEq(CurveMath.marginalPrice(7684488120277192656551936, cc), 999999999999060927);
        assertEq(CurveMath.curveIntegral(0, 7684488120277192656551936, cc), 127999999999883184502717);
    }

    function test_Curve1Monotone() public pure {
        CurveMath.CurveConfig memory cc = Curve1Zones.config();
        uint256 prevP = 0;
        uint256 prevR = 0;
        for (uint256 i = 1; i <= 512; i++) {
            uint256 s = 7684488120277192656551936 * i / 512;
            uint256 p = CurveMath.marginalPrice(s, cc);
            uint256 r = CurveMath.curveIntegral(0, s, cc);
            assertGe(p, prevP);   // price never decreases
            assertGt(r, prevR);   // reserve strictly accumulates
            prevP = p;
            prevR = r;
        }
    }

    function test_Curve1ZoneLiftsAndShape() public pure {
        CurveMath.CurveConfig memory cc = Curve1Zones.config();
        uint256 nz = cc.zones.length;
        assertEq(cc.zones[0].startSupply, 0);            // starts at origin
        assertTrue(cc.zones[0].isExponential);           // seed shelf (flat exp)
        assertTrue(!cc.zones[nz - 1].isExponential);     // log tail
        assertEq(cc.zones[nz - 1].endSupply, type(uint256).max); // unbounded
        for (uint256 i = 0; i < nz - 1; i++) {
            assertLt(cc.zones[i].startSupply, cc.zones[i].endSupply);
            uint256 pIn = CurveMath.marginalPrice(cc.zones[i].startSupply, cc);
            uint256 pOut = CurveMath.marginalPrice(cc.zones[i].endSupply, cc);
            assertGe(pOut, pIn);                         // every zone lifts
        }
        // S_end within [0.6x, 1.5x] of curvePrototype (similar amplitude)
        uint256 sEnd = cc.zones[nz - 2].endSupply;
        assertGe(sEnd, 4663465081448658125193216);
        assertLe(sEnd, 11658662703621645044547584);
    }

    function test_Curve1Telescoping() public pure {
        // B4j guarantee: any partition of a span sums bit-exactly.
        CurveMath.CurveConfig memory cc = Curve1Zones.config();
        uint256 a = 2561496040092397552183978; // S_end/3, precomputed
        uint256 b = 7040992362724194498117632;
        assertLe(a, b);
        uint256 r0a = CurveMath.curveIntegral(0, a, cc);
        uint256 rab = CurveMath.curveIntegral(a, b, cc);
        uint256 rbEnd = CurveMath.curveIntegral(b, 7684488120277192656551936, cc);
        assertEq(r0a + rab + rbEnd, CurveMath.curveIntegral(0, 7684488120277192656551936, cc));
    }
