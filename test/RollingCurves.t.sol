    function test_Curve1Anchors() public pure {
        CurveMath.CurveConfig memory cc = Curve1Zones.config();
        // (S, P, R) captured from CurveMath — exact equality, envelope contract.
        assertEq(CurveMath.marginalPrice(5301814704124618325622784, cc), 999999999998960);
        assertEq(CurveMath.curveIntegral(0, 5301814704124618325622784, cc), 2000000000000888584922);
        assertEq(CurveMath.marginalPrice(6833153559965283081256960, cc), 9999999999991221);
        assertEq(CurveMath.curveIntegral(0, 6833153559965283081256960, cc), 7999999999995565255394);
