# PSP Base Sepolia playtest environment
# Copy these values into your local .env.local (never commit .env.local),
# or save this file as .env.basesepolia and run `npm run dev -- --mode basesepolia`.
#
# NOTE: .env.local takes priority over mode files in Vite, so if you keep an
# anvil dev .env.local around, replace its contents instead of adding both.

# chain — Base Sepolia testnet
VITE_CHAIN_ID=84532

# public, CORS-open Base Sepolia RPC
VITE_RPC_URL=https://base-sepolia-rpc.publicnode.com

# deployed contract addresses — read from confirmed receipts and the deployment manifest
VITE_FACTORY=
VITE_ZAP_IN=
VITE_ZAP_OUT=

# mix token (SepoliaMixETH) + faucet addresses — from confirmed receipts and the deployment manifest.
# Both must be set for the "get mixETH" faucet buttons to appear; leave empty
# and the UI hides them entirely.
VITE_MIX=
VITE_FAUCET=

# fee-compound router from the DeployReinvestor second pass — optional,
# reinvest buttons stay hidden without it
VITE_REINVESTOR=

# native-ETH faucet link is automatic on 84532 (Coinbase faucet)

# WalletConnect project id (https://cloud.walletconnect.com)
VITE_WC_PROJECT_ID=
