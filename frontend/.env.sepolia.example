# PSP Sepolia playtest environment — deploy day (Friday)
# Copy these values into your local .env.local (never commit .env.local),
# or save this file as .env.sepolia and run `npm run dev -- --mode sepolia`.
#
# NOTE: .env.local takes priority over mode files in Vite, so if you keep an
# anvil dev .env.local around, replace its contents instead of adding both.

# chain — Ethereum Sepolia testnet
VITE_CHAIN_ID=11155111

# public Sepolia RPC
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# deployed contract addresses — paste after Friday's deploy
VITE_FACTORY=
VITE_ZAP_IN=
VITE_ZAP_OUT=

# mix token (SepoliaMixETH) + faucet addresses.
# Both must be set for the "get mixETH" faucet buttons to appear; leave empty
# on chains without a faucet and the UI hides them entirely.
VITE_MIX=
VITE_FAUCET=

# WalletConnect project id (https://cloud.walletconnect.com)
VITE_WC_PROJECT_ID=
