# production overrides for the published build (vite build mode=production)
# — no dev proxy on the host; use the CORS-open public RPC (no key in bundle)
VITE_RPC_URL=https://sepolia.base.org
VITE_RPC_FALLBACK_URL=https://base-sepolia-rpc.publicnode.com
# VITE_DEPLOYMENT_BLOCK comes from the verified deployment's local env export.
