# PSP Forknet Configuration
#
# Copy this to .env and fill in the values.
# All addresses are Ethereum mainnet (chainId 1).

# ── RPC ─────────────────────────────────────────────────────
# Required: an Ethereum mainnet RPC URL for fork testing.
# Alchemy / Infura / QuickNode / Tenderly all work.
# Get a free key from https://www.alchemy.com/ or https://infura.io/
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE

# ── Block ───────────────────────────────────────────────────
# Fork at a specific block for reproducibility.
# Leave empty to fork at latest. Set to a number for deterministic tests.
# Using a recent block ensures V4 + Alchemix V3 are deployed.
FORK_BLOCK_NUMBER=

# ── Fork Test Profile ───────────────────────────────────────
# Foundry profile for fork tests (uses higher gas limits)
# This is referenced in foundry.toml as [profile.fork]
