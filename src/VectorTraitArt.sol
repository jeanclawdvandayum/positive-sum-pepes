    /// @dev expression stamp paths for id
    function exprPaths(uint8 id) internal pure returns (string memory) {
        if (id == 0) return EXPR_NEUTRAL;
        if (id == 1) return EXPR_SMILE;
        if (id == 2) return EXPR_GRIN;
        if (id == 3) return EXPR_LAUGH;
        if (id == 4) return EXPR_SAD;
        if (id == 5) return EXPR_SCARED;
        if (id == 6) return EXPR_ANGRY;
        if (id == 7) return EXPR_SMIRK;
        return EXPR_NEUTRAL;
    }

    /// @dev eye stamp paths for id
    function eyePaths(uint8 id) internal pure returns (string memory) {
        if (id == 0) return EYES_CLASSIC;
        if (id == 1) return EYES_FEELS;
        if (id == 2) return EYES_SLEEPY;
        if (id == 3) return EYES_DERP;
        if (id == 4) return EYES_WIDE;
        if (id == 5) return EYES_BAKED;
        if (id == 6) return EYES_STARRY;
        if (id == 7) return EYES_EYEROLL;
        if (id == 8) return EYES_DEAD;
        return EYES_CLASSIC;
    }

    /// @dev expression stamp offset (48-grid cells) for id
    function exprOff(uint8 id) internal pure returns (int16 dx, int16 dy) {
        if (id == 0) return (EXPR_NEUTRAL_OFF_X, EXPR_NEUTRAL_OFF_Y);
        if (id == 1) return (EXPR_SMILE_OFF_X, EXPR_SMILE_OFF_Y);
        if (id == 2) return (EXPR_GRIN_OFF_X, EXPR_GRIN_OFF_Y);
        if (id == 3) return (EXPR_LAUGH_OFF_X, EXPR_LAUGH_OFF_Y);
        if (id == 4) return (EXPR_SAD_OFF_X, EXPR_SAD_OFF_Y);
        if (id == 5) return (EXPR_SCARED_OFF_X, EXPR_SCARED_OFF_Y);
        if (id == 6) return (EXPR_ANGRY_OFF_X, EXPR_ANGRY_OFF_Y);
        if (id == 7) return (EXPR_SMIRK_OFF_X, EXPR_SMIRK_OFF_Y);
        return (EXPR_NEUTRAL_OFF_X, EXPR_NEUTRAL_OFF_Y);
    }

    /// @dev eye stamp offset (48-grid cells) for id
    function eyeOff(uint8 id) internal pure returns (int16 dx, int16 dy) {
        if (id == 0) return (EYES_CLASSIC_OFF_X, EYES_CLASSIC_OFF_Y);
        if (id == 1) return (EYES_FEELS_OFF_X, EYES_FEELS_OFF_Y);
        if (id == 2) return (EYES_SLEEPY_OFF_X, EYES_SLEEPY_OFF_Y);
        if (id == 3) return (EYES_DERP_OFF_X, EYES_DERP_OFF_Y);
        if (id == 4) return (EYES_WIDE_OFF_X, EYES_WIDE_OFF_Y);
        if (id == 5) return (EYES_BAKED_OFF_X, EYES_BAKED_OFF_Y);
        if (id == 6) return (EYES_STARRY_OFF_X, EYES_STARRY_OFF_Y);
        if (id == 7) return (EYES_EYEROLL_OFF_X, EYES_EYEROLL_OFF_Y);
        if (id == 8) return (EYES_DEAD_OFF_X, EYES_DEAD_OFF_Y);
        return (EYES_CLASSIC_OFF_X, EYES_CLASSIC_OFF_Y);
    }

    /// @dev trait names (same order as the pixel pipeline)
    function exprName(uint8 id) internal pure returns (string memory) {
        if (id == 0) return "NEUTRAL";
        if (id == 1) return "SMILE";
        if (id == 2) return "GRIN";
        if (id == 3) return "LAUGH";
        if (id == 4) return "SAD";
        if (id == 5) return "SCARED";
        if (id == 6) return "ANGRY";
        if (id == 7) return "SMIRK";
        return "NEUTRAL";
    }

    function eyeName(uint8 id) internal pure returns (string memory) {
        if (id == 0) return "CLASSIC";
