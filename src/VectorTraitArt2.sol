    /// @dev dx, dy in 48-grid cells (x10 when used)
    int16 internal constant WEAR_HEARTGLASSES_OFF_X = 0;
    int16 internal constant WEAR_HEARTGLASSES_OFF_Y = 0;
    /// @dev dx, dy in 48-grid cells (x10 when used)
    int16 internal constant ITEM_CIGARETTE_OFF_X = 0;
    int16 internal constant ITEM_CIGARETTE_OFF_Y = 0;
    /// @dev dx, dy in 48-grid cells (x10 when used)
    int16 internal constant ITEM_PIPE_OFF_X = 0;
    int16 internal constant ITEM_PIPE_OFF_Y = 0;
    /// @dev dx, dy in 48-grid cells (x10 when used)
    int16 internal constant ITEM_CHAIN_OFF_X = 0;
    int16 internal constant ITEM_CHAIN_OFF_Y = 0;
    /// @dev dx, dy in 48-grid cells (x10 when used)
    int16 internal constant ITEM_STITCHES_OFF_X = 0;
    int16 internal constant ITEM_STITCHES_OFF_Y = 0;
    /// @dev dx, dy in 48-grid cells (x10 when used)
    int16 internal constant ITEM_TATTOO_OFF_X = 0;
    int16 internal constant ITEM_TATTOO_OFF_Y = 0;
    /// @dev dx, dy in 48-grid cells (x10 when used)
    int16 internal constant ITEM_MUSTACHE_OFF_X = 0;
    int16 internal constant ITEM_MUSTACHE_OFF_Y = 0;
    /// @dev dx, dy in 48-grid cells (x10 when used)
    int16 internal constant ITEM_NOOSE_OFF_X = 0;
    int16 internal constant ITEM_NOOSE_OFF_Y = 0;

    /// @dev hat stamp offset (48-grid cells) for id
    function hatOff(uint8 id) internal pure returns (int16 dx, int16 dy) {
        if (id == 1) return (HAT_CAP_OFF_X, HAT_CAP_OFF_Y);
        if (id == 2) return (HAT_TINFOIL_OFF_X, HAT_TINFOIL_OFF_Y);
        if (id == 3) return (HAT_CROWN_OFF_X, HAT_CROWN_OFF_Y);
        if (id == 4) return (HAT_HEADBAND_OFF_X, HAT_HEADBAND_OFF_Y);
        if (id == 5) return (HAT_NARUTO_OFF_X, HAT_NARUTO_OFF_Y);
        if (id == 6) return (HAT_TOPHAT_OFF_X, HAT_TOPHAT_OFF_Y);
        if (id == 7) return (HAT_FRENCH_OFF_X, HAT_FRENCH_OFF_Y);
        if (id == 8) return (HAT_WIZARD_OFF_X, HAT_WIZARD_OFF_Y);
        if (id == 9) return (HAT_HOMER_OFF_X, HAT_HOMER_OFF_Y);
        return (HAT_CAP_OFF_X, HAT_CAP_OFF_Y);
    }

    /// @dev eyewear stamp offset (48-grid cells) for id
    function wearOff(uint8 id) internal pure returns (int16 dx, int16 dy) {
        if (id == 1) return (WEAR_SHADES_OFF_X, WEAR_SHADES_OFF_Y);
        if (id == 2) return (WEAR_MONOCLE_OFF_X, WEAR_MONOCLE_OFF_Y);
        if (id == 3) return (WEAR_GLASSES_OFF_X, WEAR_GLASSES_OFF_Y);
        if (id == 4) return (WEAR_MOGGED_OFF_X, WEAR_MOGGED_OFF_Y);
        if (id == 5) return (WEAR_MAGNIFYING_OFF_X, WEAR_MAGNIFYING_OFF_Y);
        if (id == 6) return (WEAR_EYEPATCH_OFF_X, WEAR_EYEPATCH_OFF_Y);
        if (id == 7) return (WEAR_HEARTGLASSES_OFF_X, WEAR_HEARTGLASSES_OFF_Y);
        return (WEAR_SHADES_OFF_X, WEAR_SHADES_OFF_Y);
    }

    /// @dev item stamp offset (48-grid cells) for id
    function itemOff(uint8 id) internal pure returns (int16 dx, int16 dy) {
        if (id == 1) return (ITEM_CIGARETTE_OFF_X, ITEM_CIGARETTE_OFF_Y);
        if (id == 2) return (ITEM_PIPE_OFF_X, ITEM_PIPE_OFF_Y);
        if (id == 3) return (ITEM_CHAIN_OFF_X, ITEM_CHAIN_OFF_Y);
        if (id == 4) return (ITEM_STITCHES_OFF_X, ITEM_STITCHES_OFF_Y);
        if (id == 5) return (ITEM_TATTOO_OFF_X, ITEM_TATTOO_OFF_Y);
        if (id == 6) return (ITEM_MUSTACHE_OFF_X, ITEM_MUSTACHE_OFF_Y);
        if (id == 7) return (ITEM_NOOSE_OFF_X, ITEM_NOOSE_OFF_Y);
        return (ITEM_CIGARETTE_OFF_X, ITEM_CIGARETTE_OFF_Y);
    }

    /// @dev hat stamp paths for id (0 = NONE, 1..N in file order)
    function hatPaths(uint8 id) internal pure returns (string memory) {
        if (id == 1) return HAT_CAP;
        if (id == 2) return HAT_TINFOIL;
        if (id == 3) return HAT_CROWN;
        if (id == 4) return HAT_HEADBAND;
        if (id == 5) return HAT_NARUTO;
        if (id == 6) return HAT_TOPHAT;
        if (id == 7) return HAT_FRENCH;
        if (id == 8) return HAT_WIZARD;
        if (id == 9) return HAT_HOMER;
        return HAT_CAP;
    }

    /// @dev eyewear stamp paths for id (0 = NONE, 1..N in file order)
    function wearPaths(uint8 id) internal pure returns (string memory) {
        if (id == 1) return WEAR_SHADES;
        if (id == 2) return WEAR_MONOCLE;
        if (id == 3) return WEAR_GLASSES;
        if (id == 4) return WEAR_MOGGED;
        if (id == 5) return WEAR_MAGNIFYING;
        if (id == 6) return WEAR_EYEPATCH;
        if (id == 7) return WEAR_HEARTGLASSES;
        return WEAR_SHADES;
    }

    /// @dev item stamp paths for id (0 = NONE, 1..N in file order)
    function itemPaths(uint8 id) internal pure returns (string memory) {
        if (id == 1) return ITEM_CIGARETTE;
        if (id == 2) return ITEM_PIPE;
        if (id == 3) return ITEM_CHAIN;
        if (id == 4) return ITEM_STITCHES;
        if (id == 5) return ITEM_TATTOO;
        if (id == 6) return ITEM_MUSTACHE;
        if (id == 7) return ITEM_NOOSE;
        return ITEM_CIGARETTE;
    }

    /// @dev trait names (same order as the pixel pipeline)
    function hatName(uint8 id) internal pure returns (string memory) {
        if (id == 0) return "None";
        if (id == 1) return "CAP";
        if (id == 2) return "TINFOIL";
        if (id == 3) return "CROWN";
        if (id == 4) return "HEADBAND";
        if (id == 5) return "NARUTO";
        if (id == 6) return "TOPHAT";
        if (id == 7) return "FRENCH";
        if (id == 8) return "WIZARD";
        if (id == 9) return "HOMER";
        return "CAP";
    }

    function wearName(uint8 id) internal pure returns (string memory) {
        if (id == 0) return "None";
        if (id == 1) return "SHADES";
        if (id == 2) return "MONOCLE";
        if (id == 3) return "GLASSES";
        if (id == 4) return "MOGGED";
        if (id == 5) return "MAGNIFYING";
        if (id == 6) return "EYEPATCH";
        if (id == 7) return "HEARTGLASSES";
        return "SHADES";
    }

    function itemName(uint8 id) internal pure returns (string memory) {
        if (id == 0) return "None";
        if (id == 1) return "CIGARETTE";
        if (id == 2) return "PIPE";
        if (id == 3) return "CHAIN";
        if (id == 4) return "STITCHES";
        if (id == 5) return "TATTOO";
        if (id == 6) return "MUSTACHE";
        if (id == 7) return "NOOSE";
        return "CIGARETTE";
    }

    uint8 public constant HAT_COUNT = 10;
    uint8 public constant WEAR_COUNT = 8;
    uint8 public constant ITEM_COUNT = 8;
}
